# Candidate only. Owner authorization precedes secret relocation, DB writes and deployment.
# PAYER service only: replace existing Cardano Render runtime; no new application service.
DATABASE_URL=
PORT=10000
MULTIWALLET_INSTANCE_ID=capsule_release_REPLACE_SHA
MULTIWALLET_SIGNING_ENABLED=false
MULTIWALLET_ALLOWED_HOSTS=t2o-cardano-payer.onrender.com
MULTIWALLET_PAYER_TOKEN_FILE=/etc/secrets/multiwallet-bridge-token
# For each registered signerRef, prefix EVERY field in its existing payer configuration.
# Retain exact existing addresses, assets, payees and caps; policy is pinned in PostgreSQL.
# Examples of protected file names only; do not add private values here.
DEMO_CARDANO_PAYER_CARDANO_MNEMONIC_FILE=/etc/secrets/cardano-mnemonic
DEMO_CARDANO_PAYER_GATEWAY_TOKEN_FILE=/etc/secrets/multiwallet-gateway-token
DEMO_CARDANO_BLOCKFROST_PROJECT_ID=
DEMO_SOLANA_SOLANA_PAYER_KEY_FILE=/etc/secrets/solana-payer-key
DEMO_SOLANA_SOLANA_SPONSOR_KEY_FILE=/etc/secrets/solana-sponsor-key
DEMO_SOLANA_SOLANA_GATEWAY_TOKEN_FILE=/etc/secrets/multiwallet-gateway-token
DEMO_SUI_SUI_PAYER_KEY_FILE=/etc/secrets/sui-payer-key
DEMO_SUI_SUI_GATEWAY_TOKEN_FILE=/etc/secrets/multiwallet-gateway-token
# GATEWAY service additions: no signing keys. Existing OAuth passcode/settings unchanged.
# MULTIWALLET_PAYER_URL=https://t2o-cardano-payer.onrender.com
# MULTIWALLET_PAYER_TOKEN_FILE=/etc/secrets/multiwallet-bridge-token
# MCP_MULTIWALLET_GATEWAY_TOKEN_SHA256=<hash only>
# Remove legacy bridge variables and legacy payer gateway client hashes at approved cutover.
# Apply tools default to validation; apply flags do not authorize anything themselves.
# CAPSULE_APPROVED_SUI_IMPORT=true    only for separately approved import
# CAPSULE_APPROVED_REGISTRATION=true only for separately approved registration
