# Devnet only. Copy into a gitignored .env.solana.local and set public addresses and absolute secret paths.
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_ASSET_DECIMALS=6
SOLANA_TREASURY_ADDRESS=
SOLANA_TREASURY_TOKEN_ACCOUNT=
SOLANA_FEE_PAYER_ADDRESS=
SOLANA_FACILITATOR_URL=http://127.0.0.1:18992
# For a tunnel, both gateway and payer pin its exact HTTPS origin. The listener stays loopback.
# SOLANA_FACILITATOR_TRUSTED_ORIGIN=https://your-facilitator.example.com
# SOLANA_FACILITATOR_LISTEN_PORT=18992
SOLANA_FACILITATOR_TOKEN_FILE=C:/Dev/token2049-origins/data/solana/sponsor-token.txt
SOLANA_MAX_PAYMENT_BASE_UNITS=10000
SOLANA_PAYER_ADDRESS=
SOLANA_PAYER_TOKEN_ACCOUNT=
SOLANA_PAYER_KEY_FILE=
SOLANA_SPONSOR_KEY_FILE=
SOLANA_LEDGER_DIRECTORY=C:/Dev/token2049-origins/data/solana
SOLANA_PAYER_MAX_PURCHASE_BASE_UNITS=10000
SOLANA_PAYER_MAX_TOTAL_BASE_UNITS=10000
SOLANA_PAYER_MAX_COMMERCIAL_USD_MINOR=1000
SOLANA_SPONSOR_MAX_TOTAL_FEE_LAMPORTS=100000
SOLANA_GATEWAY_URL=http://127.0.0.1:8787
SOLANA_GATEWAY_TOKEN_FILE=C:/Dev/token2049-origins/data/solana/gateway-token.txt
# Solana payer bridge process (npm run payer:solana:bridge): loopback only. The MCP process uses the same token file via SOLANA_PAYER_BRIDGE_TOKEN_FILE.
SOLANA_PAYER_BRIDGE_PORT=8789
SOLANA_PAYER_BRIDGE_TOKEN_FILE=
