# ---------- Payer process ONLY (clients/payer). Never load into the gateway. ----------
PAYER_GATEWAY_URL=http://127.0.0.1:8787
PAYER_GATEWAY_TOKEN_FILE=./data/clients/<client>.token
PAYER_CARDANO_NETWORK=cardano:preprod
PAYER_CARDANO_MNEMONIC_FILE=./wallets/payer.mnemonic   # generated locally; gitignored; never printed
BLOCKFROST_PROJECT_ID=
PAYER_MAX_PER_PAYMENT_BASE_UNITS=100000000             # per-payment cap
PAYER_MAX_CUMULATIVE_BASE_UNITS=300000000              # cumulative cap for this process
PAYER_ALLOWED_ASSET_UNIT=                              # policyId.assetNameHex the payer may spend
