# ---------- Core (gateway process) ----------
APP_ENV=development            # development | test | sandbox   (production is refused)
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/gateway.db
PUBLIC_BASE_URL=http://127.0.0.1:8787
QUOTE_TTL_SECONDS=900
OFFER_TTL_SECONDS=1800
DEMO_PER_PURCHASE_LIMIT_USD_MINOR=50000      # approved demo spend limit per purchase (cents)
SIMULATED_CARD_CAPACITY_USD_MINOR=200000     # synthetic sandbox card capacity (cents); NOT a bank balance
SERVICE_FEE_BPS=0
WORKER_INTERVAL_MS=1000

# ---------- Direct Cardano x402 (gateway side; NO payer keys here) ----------
CARDANO_NETWORK=cardano:preprod
CARDANO_FACILITATOR_URL=               # self-hosted facilitator (recommended) or hosted preprod facilitator
CARDANO_TREASURY_ADDRESS=              # addr_test1... receive-only treasury address
CARDANO_ASSET_UNIT=                    # policyId.assetNameHex (e.g. Preprod tUSDM) — never a ticker
CARDANO_ASSET_DECIMALS=6
BLOCKFROST_PROJECT_ID=                 # secret; preprod project id (independent confirmation readback)
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# ---------- Shopify (retail) ----------
SHOPIFY_STORE_DOMAIN=                  # xxx.myshopify.com (dev store)
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_TOKEN=              # secret; Storefront API token (cart/checkout, product listings)
SHOPIFY_CLIENT_ID=                     # Dev Dashboard app (read_orders) for independent order readback
SHOPIFY_CLIENT_SECRET=                 # secret; also verifies orders/paid webhook HMAC
SHOPIFY_STORE_PASSWORD=                # secret; storefront password gate, if enabled

# ---------- Atlas (flights) ----------
ATLAS_BASE_URL=                        # sandbox host only
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=                   # secret

# ---------- Nuitée / LiteAPI (hotels) ----------
NUITEE_API_KEY=                        # secret; sandbox key
NUITEE_SEARCH_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOKING_BASE_URL=https://book.liteapi.travel/v3.0

# ---------- OCBC (observation only) ----------
OCBC_API_CLIENT_ID=
OCBC_API_CLIENT_SECRET=                # secret
OCBC_SANDBOX_BASE_URL=https://api.ocbc.com
OCBC_SANDBOX_SESSION_TOKEN=            # secret; optional customer session header
