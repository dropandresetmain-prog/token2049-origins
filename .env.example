# Gateway process only. Load with node --env-file=.env --import tsx src/main.ts.
APP_ENV=development
HOST=127.0.0.1
PORT=8787
# Local non-production Compose database. Hosted runtime uses Render's private URL.
DATABASE_URL=postgresql://origins:origins_local_only@127.0.0.1:55432/origins
PUBLIC_BASE_URL=http://127.0.0.1:8787
QUOTE_TTL_SECONDS=900
OFFER_TTL_SECONDS=1800
DEMO_PER_PURCHASE_LIMIT_USD_MINOR=50000
SIMULATED_CARD_CAPACITY_USD_MINOR=200000
SERVICE_FEE_BPS=0
WORKER_INTERVAL_MS=1000

# Receive-only Cardano Preprod configuration. Payer keys belong in a separate process.
CARDANO_NETWORK=cardano:preprod
CARDANO_FACILITATOR_URL=
CARDANO_TREASURY_ADDRESS=
CARDANO_ASSET_UNIT=
CARDANO_ASSET_DECIMALS=6
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# Own Shopify dev store + Bogus gateway + synthetic buyer data only.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-10
# Render profile uses the public Storefront token. Leave SHOPIFY_STOREFRONT_PRIVATE_TOKEN unset.
# Local delegates expire with their parent; the gateway does not mint/refresh them.
SHOPIFY_STOREFRONT_TOKEN=
# Admin readback uses client credentials; its separate Admin token is refreshed in memory.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_PASSWORD=
SHOPIFY_DEV_STORE_CONFIRMED=false
SHOPIFY_BOGUS_GATEWAY_ENABLED=false
SHOPIFY_BROWSER_EXECUTABLE=
SHOPIFY_HEADLESS=true

# Atlas sandbox only. Do not enable payment without explicit founder approval.
ATLAS_BASE_URL=https://sandbox.atriptech.com
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_ALLOW_TEST_BALANCE_PAYMENT=false

# LiteAPI requires a confirmed sandbox sand_ key; unknown/production prefixes are refused.
NUITEE_API_KEY=
NUITEE_SEARCH_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOKING_BASE_URL=https://book.liteapi.travel/v3.0

# OCBC read-only observations. Subscription entitlement and historical test data caveats apply.
OCBC_API_CLIENT_ID=
OCBC_API_CLIENT_SECRET=
OCBC_API_BASE_URL=https://api.ocbc.com
OCBC_API_CALLS_PER_MINUTE=8
OCBC_SANDBOX_SESSION_TOKEN=
