# Gateway: native ERC-20 transfer protocol on X Layer Testnet (chain 1952), NOT x402. No keys or signer history in gateway configuration.
XLAYER_NETWORK=eip155:1952
XLAYER_CHAIN_ID=1952
# Only the two official X Layer Testnet RPC endpoints are accepted.
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
# Official X Layer Testnet USD₮0 (6 decimals). Verified on-chain; the gateway rejects any other token.
XLAYER_TOKEN_ADDRESS=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
XLAYER_ASSET_DECIMALS=6
XLAYER_TREASURY_ADDRESS=
XLAYER_MAX_PAYMENT_BASE_UNITS=100000
# Gas is OKB wei (gas limit x max fee per gas). Ceiling 0.01 OKB per payment.
XLAYER_MAX_GAS_BUDGET_WEI=1000000000000000
# Confirmations required before funding is recorded (default 2, max 20).
XLAYER_CONFIRMATIONS=2

# Separate local payer only. Use absolute paths in a protected directory outside the repository.
XLAYER_PAYER_ADDRESS=
XLAYER_PAYER_KEY_FILE=
XLAYER_LEDGER_DIRECTORY=
XLAYER_GATEWAY_URL=http://127.0.0.1:8787
XLAYER_GATEWAY_TOKEN_FILE=
XLAYER_PAYER_MAX_PAYMENT_BASE_UNITS=100000
XLAYER_PAYER_MAX_DAILY_BASE_UNITS=500000
XLAYER_PAYER_MAX_TOTAL_BASE_UNITS=1000000
XLAYER_PAYER_MAX_TOTAL_GAS_WEI=10000000000000000
XLAYER_PAYER_MAX_COMMERCIAL_USD_MINOR=10000
XLAYER_PAYER_BRIDGE_TOKEN_FILE=
XLAYER_PAYER_BRIDGE_PORT=8791

# Optional existing local MCP payer connection (gateway/MCP hold only the bridge token).
XLAYER_PAYER_BRIDGE_URL=http://127.0.0.1:8791
