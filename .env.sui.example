# Gateway: native transfer protocol, NOT x402. No keys or signer history in gateway configuration.
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
SUI_ASSET_DECIMALS=6
SUI_TREASURY_ADDRESS=
SUI_MAX_PAYMENT_BASE_UNITS=100000
SUI_MAX_GAS_BUDGET_MIST=10000000

# Separate local payer only. Use absolute paths in a protected directory outside the repository.
SUI_PAYER_ADDRESS=
SUI_PAYER_KEY_FILE=
SUI_LEDGER_DIRECTORY=
SUI_GATEWAY_URL=http://127.0.0.1:8787
SUI_GATEWAY_TOKEN_FILE=
SUI_PAYER_MAX_PAYMENT_BASE_UNITS=100000
SUI_PAYER_MAX_DAILY_BASE_UNITS=500000
SUI_PAYER_MAX_TOTAL_BASE_UNITS=1000000
SUI_PAYER_MAX_TOTAL_GAS_MIST=500000000
SUI_PAYER_MAX_COMMERCIAL_USD_MINOR=10000
SUI_PAYER_BRIDGE_TOKEN_FILE=
SUI_PAYER_BRIDGE_PORT=8790

# Optional existing local MCP payer connection (gateway/MCP hold only the bridge token).
SUI_PAYER_BRIDGE_URL=http://127.0.0.1:8790
