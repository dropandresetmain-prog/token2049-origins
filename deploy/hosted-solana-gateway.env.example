# Keyless gateway settings. Use actual Render Internal hostname; placeholders are not a working connection.
SOLANA_PAYER_BRIDGE_URL=http://REPLACE_PRIVATE_HOST:8789
SOLANA_PAYER_BRIDGE_TOKEN_FILE=/etc/secrets/solana-payer-bridge-token
MCP_SOLANA_PAYER_GATEWAY_TOKEN_SHA256=
SOLANA_FACILITATOR_URL=http://REPLACE_PRIVATE_HOST:8790
SOLANA_FACILITATOR_TRUSTED_PRIVATE_ORIGIN=http://REPLACE_PRIVATE_HOST:8790
SOLANA_FACILITATOR_TOKEN_FILE=/etc/secrets/solana-facilitator-token
# Also set existing exact Devnet mint, recipient, recipient ATA and sponsor PUBLIC identities.
# Never set SOLANA_PAYER_KEY_FILE or SOLANA_SPONSOR_KEY_FILE on the public gateway.
