# Keyless gateway: exact HTTPS origin of the separate free public Solana payer.
SOLANA_PAYER_BRIDGE_URL=https://t2o-solana-payer.onrender.com
SOLANA_PAYER_BRIDGE_TOKEN_FILE=/etc/secrets/solana-payer-bridge-token
MCP_SOLANA_PAYER_GATEWAY_TOKEN_SHA256=
SOLANA_SETTLEMENT_MODE=payer_broadcast
# Existing exact Devnet mint, treasury address/ATA and sponsor PUBLIC identity are still required.
# No facilitator server, key files or Solana file-ledger directory on the gateway.
