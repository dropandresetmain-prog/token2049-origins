{
  "name": "token2049-origins-commerce-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Buyer-side commerce gateway: agent-native funding in, ordinary commerce out.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs && npm run console:build:gateway",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "readiness": "tsx scripts/readiness.ts",
    "latency": "tsx scripts/purchase-latency.ts",
    "client:create": "tsx scripts/create-client.ts",
    "mcp": "tsx src/channels/mcp/main.ts",
    "payer": "tsx clients/payer/pay.ts",
    "payer:bridge": "tsx clients/payer/bridge.ts",
    "wallet": "tsx clients/payer/wallet-generate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "payer:solana": "tsx clients/solana/pay.ts",
    "payer:solana:bridge": "tsx clients/solana/bridge.ts",
    "payer:solana:facilitator": "tsx clients/solana/facilitator.ts",
    "payer:solana:setup": "tsx scripts/solana/setup.ts",
    "e2e:solana": "tsx scripts/solana/live-e2e.ts",
    "channel:masumi": "tsx src/channels/sokosumi/main.ts",
    "console:dev": "vite --config web/vite.config.ts",
    "console:build": "vite build --config web/vite.config.ts",
    "console:build:gateway": "vite build --config web/vite.config.ts --mode gateway",
    "console:test": "vitest run --config web/vitest.config.ts",
    "console:typecheck": "tsc -p web/tsconfig.json",
    "payer:hosted": "tsx clients/payer/hosted.ts",
    "payer:hosted:init-ledger": "tsx clients/payer/hosted.ts --init-ledger",
    "cdp:treasury": "tsx src/integrations/coinbase-cdp/cli.ts"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.57.0",
    "@evolution-sdk/evolution": "0.5.14",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@solana/kit": "5.1.0",
    "@x402/cardano": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/fetch": "2.26.0",
    "@x402/svm": "2.26.0",
    "express": "5.2.1",
    "pg": "8.23.1",
    "playwright-core": "1.63.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
