{
  "name": "token2049-origins-commerce-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Buyer-side commerce gateway: agent-native funding in, ordinary commerce out.",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "readiness": "tsx scripts/readiness.ts",
    "client:create": "tsx scripts/create-client.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
