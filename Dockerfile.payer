# Hosted Cardano Preprod payer: a FREE Render web service (no disk, no private network). It holds spending authority (a mnemonic
# secret file); its spend ledger lives in the shared PostgreSQL database (migration 0005). It is a separate image from the public
# gateway. Testnet only. See docs/channels/hosted-mcp.md.
FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
# tsx is a dev dependency and runs the TypeScript sources directly, so install everything before NODE_ENV=production.
RUN npm ci
ENV NODE_ENV=production
COPY tsconfig.json ./
COPY src ./src
COPY clients/payer ./clients/payer
# Render injects PORT (default 10000); the bridge listens on it.
EXPOSE 10000
CMD ["node_modules/.bin/tsx", "clients/payer/hosted.ts"]
