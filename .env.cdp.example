# CDP API Key Wallet credentials from the CDP Portal. Keep real values in a private env file/secret store.
CDP_API_KEY_ID=replace-me
CDP_API_KEY_SECRET=replace-me
CDP_WALLET_SECRET=replace-me

# Use absolute paths on a protected, durable operator volume. The public identity contains only account addresses and policy ID.
CDP_IDENTITY_FILE=C:/secure/capsule-cdp/identity.json
CDP_ACTION_HISTORY_FILE=C:/secure/capsule-cdp/actions.json
