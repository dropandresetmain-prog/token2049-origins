# MCP process: no payer keys. Its gateway client must not have purchases:fund.
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_TOKEN_FILE=./data/clients/REPLACE_WITH_MCP_CLIENT_ID.token
# Optional bounded payer bridges: loopback only, at most one per rail, both variables of a pair required together.
# Cardano Preprod bridge (PAYER_BRIDGE_URL/PAYER_BRIDGE_TOKEN_FILE remain a legacy alias for THIS bridge only; set one spelling, not both).
CARDANO_PAYER_BRIDGE_URL=
CARDANO_PAYER_BRIDGE_TOKEN_FILE=
# Solana Devnet bridge. Must use a different URL from the Cardano bridge.
SOLANA_PAYER_BRIDGE_URL=
SOLANA_PAYER_BRIDGE_TOKEN_FILE=
# Omit to use stdio; when set, listens on 127.0.0.1 only.
MCP_HTTP_PORT=
