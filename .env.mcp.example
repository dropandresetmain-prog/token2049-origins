# MCP process: no payer keys. Its gateway client must not have purchases:fund.
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_TOKEN_FILE=./data/clients/REPLACE_WITH_MCP_CLIENT_ID.token
# Optional bounded payer bridge: loopback only, both variables required together.
PAYER_BRIDGE_URL=
PAYER_BRIDGE_TOKEN_FILE=
# Omit to use stdio; when set, listens on 127.0.0.1 only.
MCP_HTTP_PORT=
