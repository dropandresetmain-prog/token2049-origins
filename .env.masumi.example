# Preprod only. Inject secrets through the process environment; never commit real values.
SOKOSUMI_DATABASE_URL=postgresql://user:password@127.0.0.1:5433/database
SOKOSUMI_DATABASE_SCHEMA=sokosumi_preprod
SOKOSUMI_PORT=3013
GATEWAY_URL=http://127.0.0.1:3000
SOKOSUMI_CUSTOMER_ID=replace-with-core-customer-id
MASUMI_CHANNEL_AUTH_TOKEN=replace-with-at-least-32-random-characters
GATEWAY_API_TOKEN=replace-with-owner-core-token
MASUMI_NETWORK=preprod
MASUMI_PAYMENT_SERVICE_URL=http://127.0.0.1:3012
MASUMI_PAYMENT_API_KEY=replace-with-private-read-and-pay-token
MASUMI_AGENT_ID=replace-with-confirmed-native-registry-identifier
MASUMI_SELLER_VKEY=replace-with-native-selling-payment-key-hash
MASUMI_SELLER_ADDRESS=replace-with-native-selling-address
MASUMI_CONTRACT_ADDRESS=replace-with-preprod-v2-contract-address
MASUMI_PAYMENT_ASSET_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d
MASUMI_SERVICE_FEE_BASE_UNITS=10000
MASUMI_BLOCKFROST_PROJECT_ID=replace-with-private-preprod-key
SOKOSUMI_API_BASE_URL=https://api.preprod.sokosumi.com
